{
  "name": "fron-purosmates-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next .turbo 2>/dev/null; pnpm run lint:fix; pnpm run format; next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@clerk/nextjs": "^7.2.2",
    "@next/third-parties": "^16.1.6",
    "@prisma/client": "^6.19.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@use-gesture/react": "^10.3.1",
    "axios": "^1.13.4",
    "browser-image-compression": "^2.0.2",
    "heic-convert": "^2.1.0",
    "js-cookie": "^3.0.5",
    "konva": "^10.3.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.4",
    "potrace": "^2.1.8",
    "prisma": "^6.19.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-facebook-pixel": "^1.0.4",
    "react-hot-toast": "^2.6.0",
    "react-konva": "^19.2.5",
    "react-onesignal": "^3.5.1",
    "react-redux": "^9.2.0",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "20.19.33",
    "@types/potrace": "^2.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not IE 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "optionalDependencies": {
    "@img/sharp-linux-arm64": "0.34.5",
    "@img/sharp-linux-x64": "0.34.5",
    "@next/swc-darwin-arm64": "^16.2.4"
  }
}
